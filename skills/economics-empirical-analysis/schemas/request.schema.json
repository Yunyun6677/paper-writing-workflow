  },"allOf":[{"if":{"properties":{"covariance":{"const":"cluster"}}},"then":{"required":["cluster"]}}]}}
 },"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}}
}
