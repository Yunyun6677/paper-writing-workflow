{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/task-graph-proposal.schema.json",
  "title": "Bounded task graph proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "mode", "reason", "tasks"],
  "properties": {
    "schema_version": {"const": "task-graph-proposal/1.0"},
    "proposal_id": {"type": "string", "minLength": 8},
    "mode": {"enum": ["initial", "adaptive"]},
    "reason": {"type": "string", "minLength": 3},
    "parent_task_id": {"type": ["string", "null"]},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "task_type", "goal", "dependencies", "assigned_agent", "allowed_tools"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "task_type": {"enum": ["agent", "verifier", "tool", "human_gate", "final_audit"]},
          "goal": {"type": "string", "minLength": 3},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "required_inputs": {"type": "object"},
          "expected_outputs": {"type": "array", "items": {"type": "string"}},
          "assigned_agent": {"type": "string"},
          "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "retry_policy": {"type": "object"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "requires_human_approval": {"type": "boolean"},
          "verification_rules": {"type": "array", "items": {"type": "string"}},
          "tool_name": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  }
}
