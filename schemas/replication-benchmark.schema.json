{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replication-benchmark.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_date", "cases"],
  "properties": {
    "schema_version": {"const": "replication-benchmark/1.0"},
    "generated_date": {"type": "string", "format": "date"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "title", "status", "source_access", "methods", "completed", "incomplete", "engine_status"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["complete", "partial", "review-required", "blocked"]},
          "source_access": {"enum": ["public", "restricted", "browser-handoff"]},
          "methods": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "completed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "incomplete": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "engine_status": {
            "type": "object",
            "additionalProperties": {"enum": ["complete", "partial", "review-required", "not-run", "authorization-pending"]}
          },
          "handoff": {"type": ["string", "null"]}
        }
      }
    }
  }
}
