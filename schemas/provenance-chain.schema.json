{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/provenance-chain.schema.json",
  "title": "Backward-traceable scientific provenance graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "created_at", "nodes", "edges", "graph_hash"],
  "properties": {
    "schema_version": {"const": "provenance-chain/1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "graph_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "node_type", "metadata"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "node_type": {"enum": ["RawDataset", "Transformation", "AnalysisDataset", "Code", "ModelRun", "Estimate", "TableFigure", "NumericClaim", "ManuscriptClaim"]},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "value_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "metadata": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "predicate", "target"],
        "properties": {"source": {"type": "string"}, "predicate": {"type": "string"}, "target": {"type": "string"}}
      }
    }
  }
}
