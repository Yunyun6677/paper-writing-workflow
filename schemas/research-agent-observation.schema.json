{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/research-agent-observation.schema.json",
  "title": "Structured specialist agent observation",
  "type": "object",
  "additionalProperties": true,
  "anyOf": [{"required": ["status"]}, {"required": ["outcome"]}],
  "properties": {
    "status": {"enum": ["complete", "failed", "needs-human"]},
    "outcome": {"enum": ["PASS", "FAIL_TRANSIENT", "FAIL_STRATEGY", "BLOCKED", "HIGH_RISK_DECISION", "GOAL_COMPLETE"]},
    "agent_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "replacement_tasks": {"type": "array", "items": {"type": "object"}},
    "replan": {"enum": ["new_evidence", "robustness"]},
    "summary": {"type": "string"},
    "model": {"type": "string", "minLength": 1},
    "token_usage": {"type": "object", "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "cached_tokens": {"type": "integer", "minimum": 0}, "reasoning_tokens": {"type": "integer", "minimum": 0}, "cost_usd": {"type": ["number", "null"], "minimum": 0}}},
    "tool_calls": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "call_id": {"type": "string"}, "status": {"type": "string"}}}},
    "tool_requests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "call_id", "arguments"], "properties": {"name": {"type": "string"}, "call_id": {"type": "string", "minLength": 1}, "arguments": {"oneOf": [{"type": "object"}, {"type": "string"}]}}}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "human_action": {"type": "string"},
    "next_tasks": {"type": "array", "items": {"type": "object"}}
  }
}
