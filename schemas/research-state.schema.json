{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/research-state.schema.json",
  "title": "Persistent Research OS runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "run_id", "research_question", "research_goal",
    "paper_type", "current_stage", "task_graph", "active_task", "completed_tasks",
    "blocked_tasks", "pending_human_actions", "decisions", "evidence_registry",
    "literature_state", "empirical_state", "manuscript_state", "audit_state",
    "artifacts", "tool_runs", "agent_runs", "errors", "retry_count", "checkpoints",
    "parent_run_id", "lifecycle_status", "runtime_control", "memory", "data_sensitivity", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "research-state/1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
    "run_id": {"type": "string", "format": "uuid"},
    "research_question": {"type": "string", "minLength": 10},
    "research_goal": {"type": "string", "minLength": 3},
    "paper_type": {"enum": ["empirical", "theoretical", "mixed", "measurement", "replication", "review"]},
    "data_sensitivity": {"enum": ["public", "synthetic", "restricted", "personal", "confidential"]},
    "lifecycle_status": {"enum": ["initialized", "running", "paused", "waiting-agent", "waiting-human", "recovering", "blocked", "complete"]},
    "runtime_control": {"type": "object", "required": ["max_total_steps", "max_total_tasks", "max_no_progress_cycles", "total_steps", "no_progress_cycles", "strategy_replans", "max_strategy_replans"], "additionalProperties": false, "properties": {
      "max_total_steps": {"type": "integer", "minimum": 1}, "max_total_tasks": {"type": "integer", "minimum": 1}, "max_no_progress_cycles": {"type": "integer", "minimum": 1}, "total_steps": {"type": "integer", "minimum": 0}, "no_progress_cycles": {"type": "integer", "minimum": 0}, "strategy_replans": {"type": "integer", "minimum": 0}, "max_strategy_replans": {"type": "integer", "minimum": 0}
    }},
    "memory": {"type": "object", "required": ["working", "project", "researcher_preferences", "evidence"], "additionalProperties": false, "properties": {"working": {"type": "object"}, "project": {"type": "object"}, "researcher_preferences": {"type": "object"}, "evidence": {"type": "object"}}},
    "current_stage": {"type": "string", "minLength": 1},
    "task_graph": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "active_task": {"type": ["string", "null"]},
    "completed_tasks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "blocked_tasks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "pending_human_actions": {"type": "array", "items": {"$ref": "#/$defs/humanAction"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "evidence_registry": {"$ref": "#/$defs/domainState"},
    "literature_state": {"$ref": "#/$defs/domainState"},
    "empirical_state": {"$ref": "#/$defs/domainState"},
    "manuscript_state": {"$ref": "#/$defs/domainState"},
    "audit_state": {"$ref": "#/$defs/domainState"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "tool_runs": {"type": "array", "items": {"type": "object"}},
    "agent_runs": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "retry_count": {"type": "integer", "minimum": 0},
    "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "parent_run_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": ["task_id", "task_type", "goal", "dependencies", "required_inputs", "expected_outputs", "assigned_agent", "allowed_tools", "status", "retry_policy", "timeout_seconds", "stopping_condition", "success_contract", "failure_contract", "verification_rules", "attempts", "title", "kind", "owner", "depends_on", "inputs", "acceptance_criteria", "max_retries", "retry_count", "requires_human_approval", "tool_name", "observation", "error"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"},
        "task_type": {"enum": ["agent", "tool", "human_gate", "verifier", "final_audit"]},
        "goal": {"type": "string", "minLength": 3},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_inputs": {"type": "object"},
        "assigned_agent": {"enum": ["research-director", "literature-agent", "empirical-agent", "writing-agent", "reviewer-verifier-agent"]},
        "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "retry_policy": {"type": "object", "required": ["max_attempts", "retry_on"], "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 10}, "retry_on": {"type": "array", "items": {"enum": ["FAIL_TRANSIENT"]}}}},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "stopping_condition": {"type": "string", "minLength": 3},
        "success_contract": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "failure_contract": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "verification_rules": {"type": "array", "items": {"type": "string"}},
        "attempts": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 3},
        "kind": {"enum": ["agent", "tool", "human_gate", "verifier", "final_audit"]},
        "owner": {"enum": ["research-director", "literature-agent", "empirical-agent", "writing-agent", "reviewer-verifier-agent"]},
        "status": {"enum": ["pending", "running", "waiting-agent", "waiting-human", "complete", "failed", "blocked", "skipped", "superseded"]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "inputs": {"type": "object"},
        "expected_outputs": {"type": "array", "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "retry_count": {"type": "integer", "minimum": 0},
        "requires_human_approval": {"type": "boolean"},
        "tool_name": {"type": ["string", "null"]},
        "observation": {"type": ["object", "null"]},
        "error": {"type": ["string", "null"]}
      }
    },
    "humanAction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["action_id", "task_id", "question", "status", "created_at"],
      "properties": {
        "action_id": {"type": "string"},
        "task_id": {"type": "string"},
        "question": {"type": "string"},
        "status": {"enum": ["pending", "approved", "rejected", "deferred"]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "domainState": {
      "type": "object",
      "additionalProperties": true,
      "required": ["artifact_refs"],
      "properties": {
        "status": {"enum": ["pending", "running", "complete", "partial", "blocked", "review-required", "not-applicable"]},
        "schema_refs": {"type": "array", "items": {"type": "string"}},
        "artifact_refs": {"type": "array", "items": {"type": "object"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["artifact_id", "path", "sha256", "external"],
      "properties": {
        "artifact_id": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "schema_ref": {"type": "string"},
        "external": {"type": "boolean"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "path", "state_sha256", "reason", "created_at"],
      "properties": {
        "checkpoint_id": {"type": "string"},
        "path": {"type": "string"},
        "state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reason": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
