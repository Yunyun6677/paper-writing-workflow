{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "engine", "mode", "executable_name", "artifacts", "returncode", "elapsed_seconds"],
  "properties": {
    "schema_version": {"const": "engine-execution/1.0"},
    "status": {"enum": ["complete", "failed"]},
    "engine": {"enum": ["python", "stata", "r"]},
    "mode": {"type": "string", "minLength": 1},
    "executable_name": {"type": "string", "minLength": 1},
    "returncode": {"type": "integer"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
