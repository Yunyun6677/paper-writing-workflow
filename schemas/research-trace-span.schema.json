{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/research-trace-span.schema.json",
  "title": "Privacy-aware Research OS trace span",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "span_id", "parent_span_id", "run_id", "project_id", "name", "kind", "started_at", "ended_at", "latency_ms", "status", "agent", "model", "task", "tool_calls", "input_artifacts", "output_artifacts", "token_usage", "errors", "retries", "human_decisions", "data_sensitivity", "content_capture", "export_policy", "attributes"],
  "properties": {
    "schema_version": {"const": "research-trace-span/1.0"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-zA-Z0-9_-]{16,64}$"},
    "span_id": {"type": "string", "minLength": 16},
    "parent_span_id": {"type": ["string", "null"]},
    "run_id": {"type": "string"},
    "project_id": {"type": "string"},
    "name": {"type": "string", "minLength": 3},
    "kind": {"enum": ["agent", "tool", "verification", "state", "human"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "latency_ms": {"type": "number", "minimum": 0},
    "status": {"enum": ["ok", "error", "waiting", "blocked"]},
    "agent": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "task": {"type": ["string", "null"]},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "input_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
    "output_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
    "token_usage": {"type": "object", "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0}, "cached_tokens": {"type": ["integer", "null"], "minimum": 0}, "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "retries": {"type": "object", "required": ["attempt", "max_attempts"], "properties": {"attempt": {"type": "integer", "minimum": 0}, "max_attempts": {"type": "integer", "minimum": 1}}},
    "human_decisions": {"type": "array", "items": {"type": "object"}},
    "data_sensitivity": {"enum": ["public", "synthetic", "restricted", "personal", "confidential"]},
    "content_capture": {"const": false},
    "export_policy": {"enum": ["local-only", "external-redacted", "disabled"]},
    "attributes": {"type": "object"}
  },
  "$defs": {"artifactRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "sha256"], "properties": {"artifact_id": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]}}}}
}
